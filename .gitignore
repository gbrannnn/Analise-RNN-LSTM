# ==============================================================================
# Byte-compiled / optimized / DLL files
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# ==============================================================================
# Distribution / packaging
# ==============================================================================
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ==============================================================================
# Virtual Environments (Highly Recommended)
# ==============================================================================
# Standard python venv, virtualenv, pipenv, poetry, uv, etc.
.venv/
venv/
ENV/
env/
pythonenv*/
.env*/
active_env/

# ==============================================================================
# Environment Variables and Secrets (Never commit credentials)
# ==============================================================================
.env
.secrets
*.pem
*.key
*.secret

# ==============================================================================
# Inline/Local Dependency Managers (Lockfiles are usually tracked)
# ==============================================================================
# .pdm-python holds the local interpreter path
.pdm-python
.pdm-build/
# Ruff / Linting cache
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# IDEs and Code Editors (Optional but recommended)
# ==============================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/

# Jupyter Notebooks
.ipynb_checkpoints

# ==============================================================================
# Operating System files
# ==============================================================================
.DS_Store
Thumbs.db

**/pni/

.claude/